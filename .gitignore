# Las llaves de los proveedores. Viven en la maquina del operador y no en el
# repositorio: una llave commiteada es una llave quemada, aunque el repositorio
# sea privado y aunque se borre despues, porque queda en el historial.
.env
.env.*
!.env.example

# Runtime state, never source
data/
smoke-data/
*.pdf

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Node
node_modules/
.svelte-kit/
build/

# Salida de los servicios en la máquina del operador, no fuente
logs/

# Vite escribe esto mientras corre; desaparece solo
vite.config.ts.timestamp-*

# Índices de herramientas externas de asistencia. Apuntan a rutas de la máquina
# de quien las corrió, así que en otro puesto no significan nada.
.atl/

# Docker: el montaje de los discos lo genera el instalador para cada equipo.
docker-compose.override.yml
# El informe que deja diagnosticar-docker: es de cada equipo.
diagnostico-docker.txt

# El informe que deja probar-instalacion: es de cada equipo.
prueba-instalacion.txt

# Las copias sueltas que actualizar-docker aparta para poder traer la version nueva.
.actualizar-respaldo/
