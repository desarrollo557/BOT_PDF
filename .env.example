# Copie este archivo como .env y ponga las llaves que vaya a usar.
# Ninguna es obligatoria: sin llaves el sistema lee con Tesseract y decide las
# costuras dudosas mandandolas a revision, que es su comportamiento de siempre.

# Habilita "+ Mistral OCR" en la pantalla: el unico motor de esta casa que lee
# lo escrito a mano.
MISTRAL_API_KEY=

# Para juzgar costuras dudosas al separar una caja por continuidad.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cuantas paginas de OCR de pago puede gastar UN trabajo como maximo. Vacio es
# sin tope, que es lo normal. Alcanzarlo no cancela nada: el motor de pago deja
# de pedirse y lo que falte se lee con Tesseract, de modo que los documentos
# salen igual, solo que nombrados por su folio o su orden en vez de por la
# cedula. Util cuando importa mas no pasarse de una cifra que leerlo todo.
RESOLUTIONS_TOPE_PAGINAS_OCR=

# Lo que cuesta una pagina de OCR en su cuenta, para que el informe estime el
# gasto en dinero y no solo en paginas. Vacio es no estimar dinero.
RESOLUTIONS_PRECIO_OCR_POR_PAGINA=

# -- Corridas largas: opcionales, con estos valores por omision ---------------
# Un fallo no tumba la carpeta: se reintenta, se pausa y vuelve al final.
# RESOLUTIONS_REINTENTOS=2
# RESOLUTIONS_ESPERA_REINTENTO=15
# RESOLUTIONS_MINUTOS_SIN_AVANCE=20
# Cero = apagado (recomendado): reciclar procesos es lo que mas cuelga el pool.
# RESOLUTIONS_DOCUMENTOS_POR_PROCESO=0
# RESOLUTIONS_FALLOS_SEGUIDOS=10
# RESOLUTIONS_PAUSA_TRAS_FALLOS=60
# RESOLUTIONS_VUELTAS_DE_REINTENTO=1
# RESOLUTIONS_ESPERA_DEL_ORIGEN=30
# RESOLUTIONS_TRABAJOS_EN_MEMORIA=300
# 1 borra de salidas los PDF que ya estan en el destino (ahorra disco).
# RESOLUTIONS_LIBERAR_SALIDAS=
# Cuantos PDF de carpeta a la vez en "Automatico" (0 = un cuarto de los hilos).
# RESOLUTIONS_FOLDER_DOCUMENTS=0
# RESOLUTIONS_IA_A_LA_VEZ=8
